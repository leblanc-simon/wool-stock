# Wool Stock — service systemd, à installer en /etc/systemd/system/wool-stock.service.
# Voir docs/deploiement-serveur.md.

[Unit]
Description=Wool Stock, stock de pelotes de laine
Documentation=https://github.com/leblanc-simon/wool-stock
After=network.target

[Service]
Type=exec
User=wool-stock
Group=wool-stock
ExecStart=/usr/local/bin/wool-stock -c /etc/wool-stock/config.yaml serve
# Les jours des pages Entrées et Sorties sont ceux de ce fuseau.
Environment=TZ=Europe/Paris
# /var/lib/wool-stock, créé au démarrage et donné à wool-stock : la base SQLite et ses
# fichiers -wal / -shm. Seul dossier où le service peut écrire.
StateDirectory=wool-stock
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5s
# Le serveur termine les requêtes en cours pendant 15 s au plus avant de s'arrêter.
TimeoutStopSec=20s

# Durcissement : un binaire Go autonome n'a besoin que du réseau et de son dossier.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
